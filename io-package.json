        "authors": ["Florian Schirmer <jolt@tuxbox.org>"],
        "keywords": ["ioBroker", "cometvisu", "visualization", "websocket", "web"],
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "platform": "Javascript/Node.js",
        "icon": "cometvisu.png",
        "enabled": true,
        "extIcon": "https://raw.githubusercontent.com/joltcoke/ioBroker.cometvisu/main/admin/cometvisu.png",
        "readme": "https://github.com/joltcoke/ioBroker.cometvisu/blob/main/README.md",
        "loglevel": "info",
        "tier": 3,
        "mode": "daemon",
        "type": "visualization",
        "compact": true,
        "connectionType": "local",
        "dataSource": "push",
        "adminUI": {
            "config": "json"
        },
        "dependencies": [
            {
                "js-controller": ">=6.0.11"
            },
            {
                "web": ">=7.0.3"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=7.0.23"
            }
        ],
        "messagebox": true,
        "localLinks": {
            "ui": {
                "link": "%web_protocol%://%ip%:%web_port%/cometvisu/",
                "name": "CometVisu",
                "color": "greenLight",
                "order": 10
            }
        },
        "webExtension": "build/lib/web.js"
    },
    "native": {
        "version": "",
        "webInstance": "web.0"
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "files",
            "type": "meta",
            "common": {
                "name": "CometVisu build uploads",
                "type": "meta.user"
            },
            "native": {}
        },
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "CometVisu build ready",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        }
    ]
